# PostgreSQL in production. Without this, development uses persistent embedded PostgreSQL.
# Leave empty for local embedded storage. Set PostgreSQL URL on the VPS.
DATABASE_URL=
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
OWNER_EMAIL=owner@excpix.com
OWNER_PASSWORD=
# Set true only for the explicitly requested local demo owner password.
DEMO_MODE=false
